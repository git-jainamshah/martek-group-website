# Version Control Dashboard Password
# Copy this file to .env.local and change the password
ADMIN_VC_PASSWORD=martek2024!secure

# Change this to your own secure password!
# Make sure .env.local is in .gitignore (it already is)

# Optional: hero background MP4 if not in repo (large files are gitignored — host on CDN/Blob and set in Vercel)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-cdn.example.com/homepage-banner-bg.mp4

# Admin backend (Postgres)
# DATABASE_URL=postgres://user:pass@host/db   # from Vercel Storage -> Neon

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# local gh CLI bundle (optional; large binaries)
/.tools/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# local-only docs (may reference secrets)
VC_PASSWORD.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large video files (exceeds GitHub 100MB limit)
# users should add their own videos locally
public/assets/homepage-banner-bg.mp4
public/assets/*-bg.mp4
